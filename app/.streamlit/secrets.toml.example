# Copia este archivo como .streamlit/secrets.toml (NO lo subas a GitHub).
# En Streamlit Community Cloud pega lo mismo en Settings → Secrets.
[spotify]
client_id = "TU_CLIENT_ID"
client_secret = "TU_CLIENT_SECRET"
# Debe coincidir EXACTO con el Redirect URI registrado en el Dashboard de Spotify.
redirect_uri = "http://127.0.0.1:8501"
